# Normalise line endings so the repository behaves the same on Windows, WSL and Linux.
* text=auto eol=lf

*.sh text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Makefile text eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf

*.wav binary
*.png binary
*.jpg binary
*.ico binary
