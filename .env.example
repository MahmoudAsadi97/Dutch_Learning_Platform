# Copy to .env and adjust. Every variable is documented in docs/ENGINEERING.md
# (section "Configuration contract"). Values marked SECRET must never be committed.
#
# Phase A (laptop, local providers) works with this file as-is once the local
# services are installed. Phase B variables stay empty until the Azure services exist.

# --- Application -------------------------------------------------------------
APP_ENV=development                 # development | test | production
LOG_LEVEL=INFO
PAID_USAGE_ENABLED=false            # explicit owner approval required for production
APPLICATIONINSIGHTS_CONNECTION_STRING= # optional local; provisioned in Azure

# --- Identity (fixture identity is refused unless APP_ENV=development) --------
DEV_AUTH_ENABLED=true               # fixture identity through the web proxy; production must be false
DEV_OWNER_EMAIL=owner@example.com   # fixture principal; must appear in OWNER_ALLOWLIST
DEV_OWNER_NAME=Owner
OWNER_ALLOWLIST=owner@example.com   # comma-separated emails allowed to use the API

# Short-lived assertion issued by the web server for every proxied request.
ASSERTION_SIGNING_KEY=change-me-to-a-random-string-of-at-least-32-characters   # SECRET, shared by web and api
ASSERTION_ISSUER=dlp-web
ASSERTION_AUDIENCE=dlp-api
ASSERTION_TTL_SECONDS=60

# --- Network topology --------------------------------------------------------
API_HOST=127.0.0.1                  # FastAPI binds here; it has no public route
API_PORT=8000
API_INTERNAL_URL=http://127.0.0.1:8000   # where the web proxy forwards /api
WEB_PORT=3000

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://dlp:dlp@localhost:5432/dlp        # SECRET in Phase B
TEST_DATABASE_URL=postgresql+psycopg://dlp:dlp@localhost:5432/dlp_test

# --- Chat model provider -----------------------------------------------------
CHAT_PROVIDER=local                 # local | azure | fixture
LOCAL_CHAT_BASE_URL=http://localhost:11434/v1
LOCAL_CHAT_MODEL=llama3.1:8b        # any instruction-tuned model installed in Ollama
LOCAL_CHAT_MODEL_STRONG=            # optional second local model for the "strong" tier
CHAT_TIMEOUT_SECONDS=120
CHAT_MAX_OUTPUT_TOKENS=600
FEEDBACK_MAX_OUTPUT_TOKENS=1000       # feedback replies carry Persian text and need more room; a cut-off reply is retried with double
CHAT_MAX_ATTEMPTS=3
MAX_CONCURRENT_MODEL_CALLS=2
# Phase B (Azure AI Foundry, OpenAI-compatible endpoint)
AZURE_CHAT_ENDPOINT=                # e.g. https://<resource>.openai.azure.com
AZURE_CHAT_API_KEY=                 # SECRET
AZURE_CHAT_API_VERSION=v1
AZURE_CHAT_TOKEN_SCOPE=https://ai.azure.com/.default
AZURE_CHAT_DEPLOYMENT_SMALL=
AZURE_CHAT_DEPLOYMENT_STRONG=

# --- Speech-to-text ----------------------------------------------------------
STT_PROVIDER=local                  # local | azure | fixture
LOCAL_STT_MODEL=small               # faster-whisper model size (tiny, base, small, medium); medium is clearly better on non-native Dutch, ~3x slower on CPU
LOCAL_STT_DEVICE=cpu                # cpu | cuda
LOCAL_STT_COMPUTE_TYPE=int8
LOCAL_STT_CACHE_DIR=./.local/whisper
HF_TOKEN=                           # SECRET, optional: Hugging Face token for faster model downloads (whisper, Piper voices)
# Phase B
AZURE_SPEECH_KEY=                   # SECRET
AZURE_SPEECH_REGION=                # e.g. westeurope
AZURE_SPEECH_RESOURCE_ID=           # Phase B with managed identity instead of a key: the Speech resource's ARM id
AZURE_STT_LOCALE=nl-BE

# --- Text-to-speech ----------------------------------------------------------
TTS_PROVIDER=local                  # local | azure | fixture
LOCAL_TTS_VOICE=nl_BE-nathalie-medium   # Piper voice; fetched by scripts/fetch_piper_voice.py
LOCAL_TTS_VOICES_DIR=./.local/piper-voices
# Phase B
AZURE_TTS_VOICE=nl-BE-DenaNeural

# --- Blob storage ------------------------------------------------------------
BLOB_PROVIDER=azurite               # azurite | azure | memory
BLOB_CONTAINER=learner-audio
# Azurite's published development connection string (not a secret).
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;
# Phase B (managed identity, no key)
AZURE_STORAGE_ACCOUNT_URL=

# --- Audio bounds ------------------------------------------------------------
MAX_UPLOAD_BYTES=5242880            # 5 MiB per recording
MAX_AUDIO_SECONDS=30                # push-to-talk turns are short
FFMPEG_TIMEOUT_SECONDS=20
FFMPEG_MEMORY_LIMIT_MB=2048            # virtual address-space cap for ffmpeg/ffprobe; 0 disables

# --- Usage limits (enforced now; priced in Phase B) ---------------------------
USAGE_DAILY_MODEL_CALLS=200
USAGE_TOTAL_MODEL_CALLS=5000
USAGE_DAILY_TOKENS=200000
USAGE_TOTAL_TOKENS=5000000
USAGE_DAILY_AUDIO_SECONDS=1800
USAGE_TOTAL_AUDIO_SECONDS=36000

# --- Background jobs ---------------------------------------------------------
JOB_LOOP_ENABLED=true
JOB_POLL_INTERVAL_SECONDS=2
JOB_LEASE_SECONDS=60
JOB_MAX_ATTEMPTS=5
