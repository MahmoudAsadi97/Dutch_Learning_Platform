# ---------------------------------------------------------------------------
# Private owner material: never published
# ---------------------------------------------------------------------------
/instructions/
/D/
*.pdf
/.local/
/notes/
*.local.md

# Secrets and environment
.env
.env.*
!.env.example
*.pem
*.key
*.pfx

# ---------------------------------------------------------------------------
# Python (apps/api, benchmarks, scripts)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
build/
dist/
pip-wheel-metadata/

# ---------------------------------------------------------------------------
# Node (apps/web)
# ---------------------------------------------------------------------------
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
.eslintcache

# Playwright
/apps/web/test-results/
/apps/web/playwright-report/
/apps/web/blob-report/
/apps/web/playwright/.cache/

# ---------------------------------------------------------------------------
# Runtime data, caches, media
# ---------------------------------------------------------------------------
/data/
/var/
/tmp/
*.log
/apps/api/.cache/
/apps/api/tmp/
/benchmarks/language/results/
/exports/
/models/
/voices/
/recordings/
*.webm
*.m4a
*.mp3
*.ogg
# Only the small recorded fixtures under apps/api/tests/fixtures are tracked
*.wav
!/apps/api/tests/fixtures/**/*.wav
!/apps/web/tests/e2e/fixtures/*.wav
!/content/**/*.wav

# Azurite (local blob emulator) state
/__azurite_db*__.json
/__blobstorage__/
/__queuestorage__/
/azurite/

# ---------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
