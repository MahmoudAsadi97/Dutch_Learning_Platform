    {
      "id": "participle-first-two-verbs",
      "forms": [
        "dat hij het gedaan heeft",
        "gedaan heeft"
      ],
      "sense": {
        "nl": "voltooid deelwoord vóór het hulpwerkwoord",
        "en": "participle before auxiliary in a two-verb clause-final group",
        "fa": "اسم مفعول پیش از فعل کمکی در گروه دوفعلی پایان جمله"
      },
      "status": "shared_standard",
      "register": "context_dependent",
      "contexts": [
        "two-verb clause-final group with a participle"
      ],
      "shared_standard_alternatives": [
        "dat hij het heeft gedaan",
        "heeft gedaan"
      ],
      "term": "green_order",
      "guidance": "Both orders are grammatical. Participle-first is traditionally called green order. Do not generalise the rule to every infinitive or larger verb cluster, and do not assign a blanket Belgian-versus-Netherlands division.",
      "source_ids": [
        "two-verb-order",
        "red-green-terms"
      ]
    },
    {
      "id": "auxiliary-first-two-verbs",
      "forms": [
        "dat hij het heeft gedaan",
        "heeft gedaan"
      ],
      "sense": {
        "nl": "hulpwerkwoord vóór het voltooid deelwoord",
        "en": "auxiliary before participle in a two-verb clause-final group",
        "fa": "فعل کمکی پیش از اسم مفعول در گروه دوفعلی پایان جمله"
      },
      "status": "shared_standard",
      "register": "context_dependent",
      "contexts": [
        "two-verb clause-final group with a participle"
      ],
      "shared_standard_alternatives": [
        "dat hij het gedaan heeft",
        "gedaan heeft"
      ],
      "term": "red_order",
      "guidance": "Both orders are grammatical. Auxiliary-first is traditionally called red order. Do not mark the alternative incorrect.",
      "source_ids": [
        "two-verb-order",
        "red-green-terms"
      ]
    },
